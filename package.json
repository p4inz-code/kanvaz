{
  "name": "kanvaz",
  "version": "9.0.0",
  "description": "Reference Operating System — collect, organize, connect, and understand your references.",
  "private": true,
  "main": "src/main.js",
  "author": "Atharva Patil | P4inz | Northbyte Studios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/p4inz-code/kanvaz.git"
  },
  "bugs": {
    "url": "https://github.com/p4inz-code/kanvaz/issues"
  },
  "homepage": "https://github.com/p4inz-code/kanvaz#readme",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "dist": "electron-builder --win",
    "lint": "node test/lint.js",
    "validate": "node test/validate.js",
    "test:ports": "node test/run-port-test.js",
    "test:format": "node test/format-roundtrip-test.js",
    "test:plugins": "node test/plugin-loader-test.js"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "puppeteer-core": "^25.3.0"
  },
  "build": {
    "appId": "com.northbytestudios.kanvaz",
    "productName": "Kanvaz",
    "copyright": "Copyright 2026 Atharva Patil | P4inz | Northbyte Studios",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "kanvaz",
        "name": "Kanvaz Board",
        "description": "Kanvaz Reference Board",
        "mimeType": "application/x-kanvaz",
        "role": "Editor",
        "icon": "assets/icons/icon"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "bmp",
          "webp"
        ],
        "name": "Image",
        "description": "Image (opens as a card on a Kanvaz board)",
        "role": "Viewer",
        "rank": "Alternate",
        "icon": "assets/icons/icon"
      },
      {
        "ext": [
          "gif"
        ],
        "name": "Animated GIF",
        "description": "Animated GIF (opens as a card on a Kanvaz board)",
        "role": "Viewer",
        "rank": "Alternate",
        "icon": "assets/icons/icon"
      },
      {
        "ext": [
          "mp4",
          "webm",
          "mov",
          "mkv",
          "avi"
        ],
        "name": "Video",
        "description": "Video (opens as a card on a Kanvaz board)",
        "role": "Viewer",
        "rank": "Alternate",
        "icon": "assets/icons/icon"
      },
      {
        "ext": [
          "mp3",
          "wav",
          "ogg",
          "m4a"
        ],
        "name": "Audio",
        "description": "Audio (opens as a card on a Kanvaz board)",
        "role": "Viewer",
        "rank": "Alternate",
        "icon": "assets/icons/icon"
      },
      {
        "ext": [
          "glb",
          "gltf",
          "obj",
          "fbx",
          "stl",
          "ply",
          "vox",
          "usd",
          "usda",
          "usdc",
          "usdz"
        ],
        "name": "3D Model",
        "description": "3D Model (opens as a card on a Kanvaz board)",
        "role": "Viewer",
        "rank": "Alternate",
        "icon": "assets/icons/icon"
      },
      {
        "ext": [
          "blend"
        ],
        "name": "Blender File",
        "description": "Blender File (opens as a card on a Kanvaz board)",
        "role": "Viewer",
        "rank": "Alternate",
        "icon": "assets/icons/icon"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF Document (opens as a card on a Kanvaz board)",
        "role": "Viewer",
        "rank": "Alternate",
        "icon": "assets/icons/icon"
      },
      {
        "ext": [
          "psd",
          "psb",
          "ai",
          "xd",
          "indd",
          "indt"
        ],
        "name": "Adobe File",
        "description": "Adobe File (opens as a card on a Kanvaz board)",
        "role": "Viewer",
        "rank": "Alternate",
        "icon": "assets/icons/icon"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns",
      "minimumSystemVersion": "12.0.0"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png",
      "mimeTypes": [
        "application/x-kanvaz",
        "image/jpeg",
        "image/png",
        "image/bmp",
        "image/webp",
        "image/gif",
        "video/mp4",
        "video/webm",
        "video/quicktime",
        "video/x-matroska",
        "video/x-msvideo",
        "audio/mpeg",
        "audio/wav",
        "audio/x-wav",
        "audio/ogg",
        "audio/mp4",
        "model/gltf-binary",
        "model/gltf+json",
        "model/obj",
        "model/stl",
        "model/vnd.usdz+zip",
        "application/x-blender",
        "application/pdf",
        "image/vnd.adobe.photoshop",
        "application/vnd.adobe.illustrator",
        "application/vnd.adobe.xd",
        "application/x-indesign"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "p4inz-code",
      "repo": "kanvaz"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "wink-distance": "^2.0.2",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^1.14.3"
  }
}
